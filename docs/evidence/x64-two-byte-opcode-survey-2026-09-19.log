# two-byte (0F xx) opcode survey, 2026-09-19, fourth pass: same 12 probes, padding 0x90 instead of 0x00 so the screen reads the exact bytes of probe0f_2026-09-19.bin (the three-byte 0F 38/3A maps and 3DNow 0F 0F read the byte after as ModRM/suffix, so padding is part of the probe); supersedes the third pass (same day), the three-form pass (08f26af) and a one-form pass: decoded in 64-bit mode by src/decoders/x86_decoder.c at private HEAD 130188c (decoder unchanged since bf97521, post fix (m)), versus the first-instruction length from objdump -D -b binary -m i386:x86-64 --insn-width=16 (Binutils 2.42). objdump is the screening tool; expected values for any red come from the pinned Ghidra oracle (12.1.2, snap rev 47).
# Probe: [PFX] 0F xx MODRM + nine 0x00; PFX in {none, 66, F2, F3} (in the two-byte map a mandatory prefix selects the instruction, sometimes a different length: 0F 78 bare VMREAD 3, 66 0F 78 EXTRQ 6); MODRM in {00, 80, C0}. 12 probes per opcode, 3072 rows. Each widening only moves an opcode from invalid to valid, so the invalid count is a CEILING: 43 (one form) -> 32 (three forms) -> 23 (twelve probes).
# survey program (0x90-padded):
#   #include <stdio.h>
#   #include <string.h>
#   #include "x86_decoder.h"
#   /* two-byte map survey: [PFX] 0F xx MODRM + nine 0x00; PFX in {none,66,F2,F3}, MODRM in {00,80,C0} */
#   int main(void){
#     static const int pfx[4]={-1,0x66,0xF2,0xF3}; static const uint8_t forms[3]={0x00,0x80,0xC0};
#     for(int p=0;p<4;p++) for(int f=0;f<3;f++) for(int b=0;b<256;b++){
#       uint8_t code[13]; memset(code,0x90,sizeof code); int i=0; if(pfx[p]>=0) code[i++]=(uint8_t)pfx[p];
#       code[i++]=0x0F; code[i++]=(uint8_t)b; code[i++]=forms[f];
#       x86_decoder_t dec; x86_decoded_t d; memset(&d,0,sizeof d);
#       x86_decoder_init(&dec,X86_MODE_64,code,i+9,0x1000);
#       int n=x86_decode_one(&dec,&d);
#       printf("%s %02X 0F%02X ours_len=%d ours_ins=%s\n",pfx[p]<0?"--":(pfx[p]==0x66?"66":pfx[p]==0xF2?"F2":"F3"),forms[f],b,n,x86_ins_name(d.instruction));
#     }
#     return 0;
#   }
#   trailing imm8 after ModRM (0F default arm reads ModRM only): 0F70 (pshufw/pshufd/pshuflw/pshufhw), 0FC2 (cmpps/pd/sd/ss), 0FC4 (pinsrw mm/xmm), 0FC5 (pextrw, C0 only) -- one short in every prefix and ModRM form
#   no ModRM (arm consumes one): 0FAA rsm -- one long in every form
#   mod field ignored by hardware, decoder honours it as memory: 0F20 0F21 0F22 0F23 mov cr/dr -- 7 vs 3 at modrm 80, every prefix
#   prefix selects a different-length instruction: 0F78 -- 66 0F 78 extrq ib ib and F2 0F 78 insertq ib ib are 6, decoder 4 (bare 0F 78 vmread is 3 and agrees)
#   vendor-divergent, NOT a defect claim: 66 0F 80..8F jcc near -- objdump models rel16 (5), decoder reads rel32 (7); same question as 66 E8/E9, resolved as 'modeled as N by the oracle at pin 12.1.2; known vendor-divergent'
