# two-byte (0F xx) opcode survey, 2026-09-19: decoded in 64-bit mode by src/decoders/x86_decoder.c at private HEAD 00c56ad (decoder unchanged since bf97521, post fix (m)), versus the first-instruction length from objdump -D -b binary -m i386:x86-64 --insn-width=16 (Binutils 2.42). objdump is the screening tool; expected values for any red come from the pinned Ghidra oracle (12.1.2, snap rev 47).
# Probe: 0F xx MODRM + nine 0x00, MODRM in {00 (memory, no disp), 80 (memory, disp32: exposes the has_modrm bit), C0 (register form: reaches mod=11-only opcodes such as PEXTRW)}. A one-form probe is a floor, not a count (review 2026-09-19); an earlier zero-only and C0-only pass of this survey found 5 wrong-length opcodes, this three-form pass finds 9.
# survey program:
#   #include <stdio.h>
#   #include <string.h>
#   #include "x86_decoder.h"
#   /* two-byte map survey: 0F xx MODRM + nine 0x00, MODRM in {00,80,C0} */
#   int main(void){
#     static const uint8_t forms[3]={0x00,0x80,0xC0};
#     for(int f=0;f<3;f++) for(int b=0;b<256;b++){
#       uint8_t code[12]={0}; code[0]=0x0F; code[1]=(uint8_t)b; code[2]=forms[f];
#       x86_decoder_t dec; x86_decoded_t d; memset(&d,0,sizeof d);
#       x86_decoder_init(&dec,X86_MODE_64,code,sizeof code,0x1000);
#       int n=x86_decode_one(&dec,&d);
#       printf("%02X 0F%02X ours_len=%d ours_ins=%s\n",forms[f],b,n,x86_ins_name(d.instruction));
#     }
#     return 0;
#   }
